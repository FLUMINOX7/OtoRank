# Configuration de l'API
API_BASE_URL=https://api.otorank.com
API_VERSION=v1
API_TIMEOUT=30000

# Configuration de l'authentification
# AUTH_CLIENT_ID=your_client_id_here
# AUTH_CLIENT_SECRET=your_client_secret_here

# Clés API tierces (à ne jamais committer en dur)
# GOOGLE_API_KEY=your_google_api_key
# FIREBASE_API_KEY=your_firebase_api_key

# Configuration de l'environnement
ENVIRONMENT=development
DEBUG_MODE=true

# Analytics (optionnel)
# ENABLE_ANALYTICS=false
# ANALYTICS_ID=your_analytics_id

# Note: Créez un fichier .env avec vos vraies valeurs
# Le fichier .env est ignoré par Git pour la sécurité
